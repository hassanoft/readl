# Liste de référence des variables utilisées par READL.
#
# Ce fichier documente les clés nécessaires, mais Flutter ne lit pas les
# fichiers .env nativement : pour lancer l'app, utilisez plutôt
# `env.json.example` (copié en `env.json`) avec --dart-define-from-file,
# ou passez les valeurs directement via --dart-define (voir le README).
# Ne jamais committer les vraies valeurs, quel que soit le format choisi.

# Dashboard Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Réservé aux prochaines étapes (Mode Étudiant / IA) — ne jamais exposer
# une clé secrète d'IA directement dans l'app. Cette valeur doit pointer
# vers un endpoint backend (Supabase Edge Function) qui, lui, détient la
# vraie clé côté serveur.
AI_API_URL=
AI_API_KEY=
